MCP_REGISTRY_SOURCE_PATH=./fixtures/registry.json
PORT=3000

# Optional site branding
SITE_NAME=MCP Registry
SITE_DESCRIPTION=Browse and discover MCP servers.
SITE_REPOSITORY_URL=
# Header logo image URL (absolute or root-relative). Defaults to the bundled
# /logo.svg mark.
SITE_LOGO_URL=

# Optional base path when serving the registry under a sub-path (e.g. behind
# a proxy at example.com/registry). Old root-relative URLs keep working via
# internal rewrites. Leave unset to serve from the domain root.
NEXT_PUBLIC_BASE_PATH=

# Optional API analytics
# DATABASE_URL enables reading search stats (popularity sorting, trending searches).
# ENABLE_ANALYTICS additionally records incoming API requests.
ENABLE_ANALYTICS=false
DATABASE_URL=
ANALYTICS_SALT=
